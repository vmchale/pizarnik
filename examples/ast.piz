@prelude/fn

type Name = { Int Str `name };
type ResVar = { `x ⊕ `y };

type AbsAST a = { a a `ap ⊕ a Name `lam ⊕ Name `var };
type AST = AbsAST(AST);

type DExpr = AbsAST(DExpr) ∪ { DExpr `dfn ⊕ ResVar `resVar };
type Syn = AbsAST(Syn) ∪ { DExpr `dfn };

fresh : Int -- Int Name Name
      := [ 1 + dup 1 + dup ["x" `name] dip "y" `name ]

dedfn : Int Name Name DExpr -- Int AST
      := [ { `resVar⁻¹ { `x⁻¹ drop & `y⁻¹ nip } `var
           & `lam⁻¹ [dedfn] dip `lam
           & `var⁻¹ drop2 `var
           & `dfn⁻¹ [drop2 fresh] dip dedfn
           & `ap⁻¹ [dup2] dip2 (243) [dedfn] dip3 (45) dedfn (32) `ap
           } ]

# TODO: "under" permutation... (23) [f] (32) for example

desugar : Int Syn -- Int AST
        := [ { `dfn⁻¹ [fresh] dip dedfn
             & `lam⁻¹ [desugar] dip `lam
             & `var⁻¹ `var
             & `ap⁻¹ [desugar] dip (32) desugar (23) `ap
             }
           ]

# convert to IR?

printName : Name -- Str
          := [ { `name⁻¹ nip } ]

printAbs : [a -- Str] AbsAST(a) -- Str
         := [ { `var⁻¹ printName nip
              & `lam⁻¹ printName ["λ"] dip strcat "." strcat [$] dip swap strcat
              & `ap⁻¹ [dup] dip2 (24) [$] dip2 (231) [$] dip swap [["("] dip strcat] dip ")" strcat strcat
              }
            ]

printDExpr : DExpr -- Str
           := [ { `resVar⁻¹ { `x⁻¹ "x" & `y⁻¹ "y" }
                & `dfn⁻¹ printDExpr ["["] dip strcat "]" strcat
                & [[printDExpr]] dip printAbs
                }
              ]

# another upside: anything that works on a Syn will work on an AST (e.g. stripping comments, pretty-printer...) AS IT SHOULD
