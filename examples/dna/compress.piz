@dna

w : { `a ⊕ `t } --
  := [{ `a^ & `t^ }]

s : { `c ⊕ `g } --
  := [{ `c^ & `g ^ }]

k : { `g ⊕ `t } --
  := [{ `g^ & `t^ }]

r : { `a ⊕ `g } --
  := [{ `a^ & `g^ }]

y : { `c ⊕ `t } --
  := [{ `c^ & `t^ }]

b : { `c ⊕ `g ⊕ `t } --
  := [{ `c^ & `g^ & `t^ }]

d : { `a ⊕ `g ⊕ `t } --
  := [{ `a^ & `g^ & `t^ }]

h : { `a ⊕ `c ⊕ `t } --
  := [{ `a^ & `c^ & `t^ }]

v : { `a ⊕ `c ⊕ `g } --
  := [{ `a^ & `c^ & `g^ }]

n : Dna --
  := [{ `a^ & `c^ & `g^ & `t^ }]
