type K = {`e ⊕ `a ⊕ `b ⊕ `c};

# https://mathworld.wolfram.com/Vierergruppe.html
mult : K K -- K
     := [ { `e⁻¹ &
            `a⁻¹ { `e⁻¹ `a & `a⁻¹ `e & `b⁻¹ `c & `c⁻¹ `b } &
            `b⁻¹ { `e⁻¹ `b & `a⁻¹ `c & `b⁻¹ `e & `c⁻¹ `a } &
            `c⁻¹ { `e⁻¹ `c & `a⁻¹ `b & `b⁻¹ `a & `c⁻¹ `e }
          }
        ]

mult0 : K K -- K
      := [ { `e⁻¹ `e⁻¹ `e & `e⁻¹ `a⁻¹ `a & `e⁻¹ `b⁻¹ `b & `e⁻¹ `c⁻¹ `c
           & `a⁻¹ `e⁻¹ `a & `a⁻¹ `a⁻¹ `c & `a⁻¹ `b⁻¹ `e & `a⁻¹ `c⁻¹ `a
           & `b⁻¹ `e⁻¹ `b & `b⁻¹ `a⁻¹ `c & `b⁻¹ `b⁻¹ `e & `b⁻¹ `c⁻¹ `a
           & `c⁻¹ `e⁻¹ `c & `c⁻¹ `a⁻¹ `b & `c⁻¹ `b⁻¹ `a & `c⁻¹ `c⁻¹ `e
           } ]
