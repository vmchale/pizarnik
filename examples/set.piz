@prelude/fn
@prelude/ord

type Set o = { `nil +. Set(o) o Set(o) `branch };

insert : Int Set(Int) -- Set(Int)
       := [ { `nil^ [`nil] dip `nil `branch
            & `branch^ (14) dup2 cmpInt
                { `eq^ (342) drop `branch
                & `gt^ (123) insert (13) `branch
                & `lt^ (124) insert (23) `branch
                }
            }
          ]

member : Int Set(Int) -- Bool
       := [ { `nil^ drop False
            & `branch^ (14) dup (13) cmpInt
              { `eq^ drop3 True
              & `gt^ nip (12) member
              & `lt^ nip2 (12) member
              }
            }
          ]
