                # } ]

something : Bool Maybe(a) -- Bool
          := [{`just⁻¹ _ True⁻¹ True &
               `nothing⁻¹ False⁻¹ False &
               `just⁻¹ _ False⁻¹ False &
               `nothing⁻¹ True⁻¹ True}]
