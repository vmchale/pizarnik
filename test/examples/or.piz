@prelude/fn
@lib/maybe

type These a b = { a `left ⊕ b `right ⊕ a b `both };

left : { a `left ⊕ a b `both } -- a
     := [ { `left⁻¹ & `both⁻¹ nip } ]

maybeLeft : These(a,b) -- Maybe(a)
          := [ { left `just & `right⁻¹ drop `nothing } ]

hasLeft : These(a,b) -- Bool
        := [ { left drop True & `right⁻¹ drop False } ]
