@prelude/bool
@lib/list

# basically w/ foldl... if we have a universal variable e.g. from stack variable 'B in
# 'B ['B a -- 'B] List(a) -- 'B
# but then variables aren't permeable on the right?

ands : List(Bool) -- Bool
     := [ [True [and]] dip foldl ]

ors : List(Bool) -- Bool
    := [ [False [or]] dip foldl ]

x : -- List(Bool)
  := [ `nil False `cons True `cons False `cons ]
