@prelude/fn

type List a = { `nil ⊕ List(a) a `cons };

type NE a = { List(a) a `cons };

foldl : 'B [ 'B a -- 'B ] List(a) -- 'B
      := [ { `nil⁻¹ drop
           & `cons⁻¹ [dup] dip2 (142) [$] dip2 foldl
           }
         ]

head : NE(a) -- a
     := [ { `cons⁻¹ nip } ]

tail : NE(a) -- List(a)
    := [ { `cons⁻¹ _ } ]

concat : List(a) List(a) -- List(a)
      := [ { `nil^
           & `cons^ (132) concat swap `cons
           }
         ]

replicate : a Int -- List(a)
          := [ dup 0 = { True^ drop2 `nil & False^ 1 - [dup] dip replicate swap `cons } ]

map : [a -- b] List(a) -- List(b)
    := [ { `nil^ drop `nil
         & `cons^ [dup] dip2 (1432) [$] dip2 map (12) `cons
         }
       ]
