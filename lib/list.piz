@prelude/fn

type List a = { `nil ⊕ List(a) a `cons };

type NE a = { List(a) a `cons };

foldr : [ a b -- b ] b List(a) -- b
      := [ { `nil⁻¹ nip
           & `cons⁻¹ [dup] dip3 (152)(34) [$] dip2 (23) foldr } ]

head : NE(a) -- a
     := [ { `cons⁻¹ nip } ]

tail : NE(a) -- List(a)
    := [ { `cons⁻¹ _ } ]

concat : List(a) List(a) -- List(a)
      := [ { `nil^
           & `cons^ (132) concat swap `cons
           }
         ]
