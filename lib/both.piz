@prelude/fn
@lib/either

type Both a b = Either(a,b) ∪ { a b `both };

# idk if this is useful (or-pattern demonstration binding variables)
left : { a `left ⊕ a b `both } -- a
     := [ { `left⁻¹ & `both⁻¹ drop } ]

mapL : [a -- b] Both(a,c) -- Both(b,c)
     := [ { mapLeft
          & `both^ [swap $] dip `both
          }
        ]

bimap : [a -- b] [c -- d] Both(a,c) -- Both(b,d)
      := [ { `left^ nip swap $ `left
           & `right^ nip2 swap $ `right
           & `both^ (243) [$] dip2 (13) [$] dip swap `both
           } ]
