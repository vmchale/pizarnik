@prelude/fn

type Tree a = { a `leaf ⊕ Tree(a) Tree(a) a `node };

map : [a -- b] Tree(a) -- Tree(b)
    := [ { `leaf⁻¹ swap $ `leaf
         & `node⁻¹ (1432) [dup] dip2 [$] dip3 [dup] dip2 (23) map [map] dip (312) `node
         }
       ]

fold : [b a -- b] b Tree(a) -- b
     := [ { `leaf⁻¹ (123) $
          & `node⁻¹ (14532) [dup] dip2 [$] dip3 (34) [dup] dip3 [fold] dip fold
          }
        ]
